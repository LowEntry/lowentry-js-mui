{
	"name": "@lowentry/mui",
	"version": "2.0.2",
	"description": "Provides utilities for Material UI.",
	"type": "module",
	"author": "Low Entry",
	"license": "MIT",
	"homepage": "https://github.com/LowEntry/lowentry-js-mui",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LowEntry/lowentry-js-mui.git"
	},
	"bugs": {
		"url": "https://github.com/LowEntry/lowentry-js-mui/issues"
	},
	"keywords": [
		"materialui",
		"mui",
		"plugin",
		"utility",
		"utilities"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"lint": "eslint .",
		"format": "eslint . --fix",
		"test": "npm run type-check && npm run lint && vitest run",
		"type-check": "tsc --noEmit",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf dist coverage",
		"prepublishOnly": "npm run clean && npm test && npm run build"
	},
	"dependencies": {
		"@lowentry/react-redux": "^2.0.1",
		"@lowentry/utils": "^2.0.8",
		"dayjs": "^1.11.19"
	},
	"peerDependencies": {
		"@emotion/react": "^11.0.0",
		"@emotion/styled": "^11.0.0",
		"@mui/icons-material": "^5.0.0 || ^6.0.0 || ^7.0.0",
		"@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0",
		"@mui/x-date-pickers": "^6.0.0 || ^7.0.0 || ^8.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^7.3.7",
		"@mui/material": "^7.3.7",
		"@mui/x-date-pickers": "^8.26.0",
		"@stylistic/eslint-plugin": "^5.7.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.2",
		"eslint-plugin-jsonc": "^2.21.0",
		"eslint-plugin-react-hooks": "^7.0.1",
		"jsdom": "^27.4.0",
		"jsonc-eslint-parser": "^2.4.2",
		"less": "^4.5.1",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.1",
		"vitest": "^4.0.18"
	}
}
